{
  "name": "sindprf",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "docker:up": "docker compose -f docker-compose.dev.yml up --build",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose up --build -d",
    "docker:prod:down": "docker compose down",
    "docker:prod:logs": "docker compose logs -f",
    "prisma:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "postinstall": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "build:types": "npm run build -w packages/types",
    "build:api": "npm run build:types && npm run prisma:generate && npm run build -w apps/api",
    "build:web": "npm run build:types && npm run build -w apps/web",
    "build": "npm run build:types && npm run prisma:generate && npm run build -w apps/api && npm run build -w apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=20"
  }
}
