// Schema Prisma — Sistema de Sindicatos (multi-tenant)
// Postgres · auth, notícias, convênios, eleição, imóveis, D8, balancetes
//
// Convenções:
// - Datas em UTC (@db.Timestamptz). Conversão p/ America/Fortaleza só na exibição.
// - Constraints de integridade no banco (unique, FK), não só na aplicação.
// - IDs em cuid() por padrão.

generator client {
  provider      = "prisma-client-js"
  // native = local/Docker; rhel-openssl-3.0.x = runtime Node da Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexão direta (sem pooler) — migrations/seed. Em serverless use o pooler em DATABASE_URL.
  directUrl = env("DIRECT_URL")
}


// =====================================================================
// MULTI-TENANT (Fase A)
// =====================================================================

model Tenant {
  id        String     @id @default(cuid())
  slug      String     @unique
  nome      String
  tipo      TenantTipo @default(SINDICATO)
  timezone  String     @default("America/Fortaleza")
  ativo     Boolean    @default(true)
  /// Branding/config JSON (Fase B) — ver tenantBrandingSchema em @sindprf/types.
  branding  Json?
  createdAt DateTime   @default(now()) @db.Timestamptz
  updatedAt DateTime   @updatedAt @db.Timestamptz

  domains              TenantDomain[]
  users                User[]
  afiliados            Afiliado[]
  importacoesD8        ImportacaoD8[]
  linhasD8             LinhaD8[]
  noticias             Noticia[]
  pushSubscriptions    PushSubscription[]
  instagramPosts       InstagramPost[]
  convenios            Convenio[]
  declaracoesEmitidas  DeclaracaoEmitida[]
  eleicoes             Eleicao[]
  membrosComissao      MembroComissaoEleitoral[]
  chapas               Chapa[]
  contestacoes         ContestacaoChapa[]
  candidatos           Candidato[]
  elegiveis            Elegivel[]
  comparecimentos      Comparecimento[]
  votos                Voto[]
  resultados           ResultadoApuracao[]
  imoveis              Imovel[]
  fotosImovel          FotoImovel[]
  periodos             Periodo[]
  solicitacoes         SolicitacaoAluguel[]
  mensagens            Mensagem[]
  importacoesBalancete ImportacaoBalancete[]
  linhasBalancete      LinhaBalancete[]
  refreshTokens        RefreshToken[]
  resetTokens          PasswordResetToken[]
  alertas              Alerta[]
  formularios          Formulario[]
  respostasFormulario  RespostaFormulario[]
  documentosAfiliados  DocumentoAfiliado[]
  dependentesAfiliados DependenteAfiliado[]

  @@map("tenants")
}

enum TenantTipo {
  SINDICATO
  PLATAFORMA
}

model TenantDomain {
  id        String   @id @default(cuid())
  tenantId  String
  /// Hostname sem porta, lowercase (ex.: www.sindprfce.com.br, localhost).
  host      String   @unique
  primario  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

// =====================================================================
// FASE 0/1 — USUÁRIOS, AUTENTICAÇÃO E AFILIADOS
// =====================================================================

enum Role {
  SUPERADMIN
  ADMIN
  AFILIADO
}

enum StatusAfiliado {
  PENDENTE
  APROVADO
  INATIVO
}

enum TipoD8 {
  SERVIDOR
  PENSIONISTA
}

enum TipoDocumentoFiliacao {
  IDENTIDADE_CPF
  COMPROVANTE_ENDERECO
  CONTRACHEQUE
  FOTO_3X4
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  UNIAO_ESTAVEL
  SEPARADO
  DIVORCIADO
  VIUVO
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  senhaHash String
  role      Role     @default(AFILIADO)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  afiliado       Afiliado?
  refreshTokens  RefreshToken[]
  resetTokens    PasswordResetToken[]
  noticias       Noticia[]        @relation("AutorNoticia")
  mensagens      Mensagem[]       @relation("AutorMensagem")
  membrosComissao        MembroComissaoEleitoral[]
  contestacoesDecididas  ContestacaoChapa[]        @relation("DecisorContestacao")
  declaracoesAssinadas   DeclaracaoEmitida[]       @relation("DeclaracoesAssinadas")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String   @unique
  expiraEm  DateTime @db.Timestamptz
  revogado  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  tokenHash String   @unique
  expiraEm  DateTime @db.Timestamptz
  usado     Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("password_reset_tokens")
}

model Afiliado {
  id         String         @id @default(cuid())
  tenantId   String
  userId     String         @unique
  nome       String
  cpf        String
  matricula  String
  telefone   String?
  categoria  TipoD8?
  status     StatusAfiliado @default(PENDENTE)

  /// Ficha de filiação — nula nos cadastros feitos direto pela secretaria.
  dataNascimento   DateTime?    @db.Date
  rg               String?
  orgaoExpedidor   String?
  naturalidade     String?
  estadoCivil      EstadoCivil?
  nomeMae          String?
  nomePai          String?
  conjuge          String?
  endereco         String?
  complemento      String?
  bairro           String?
  cidade           String?
  uf               String?      @db.VarChar(2)
  cep              String?      @db.VarChar(8)
  lotacaoSiape     String?
  lotacaoAtividade String?
  dataAdmissao     DateTime?    @db.Date
  celular          String?
  celular2         String?
  emailFuncional   String?
  /// Momento em que aceitou o estatuto e autorizou o desconto em folha.
  aceiteEstatutoEm DateTime?    @db.Timestamptz

  createdAt  DateTime       @default(now()) @db.Timestamptz
  updatedAt  DateTime       @updatedAt @db.Timestamptz

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  elegibilidades   Elegivel[]
  comparecimentos  Comparecimento[]
  solicitacoes     SolicitacaoAluguel[]
  contestacoes     ContestacaoChapa[]
  linhasD8         LinhaD8[]
  declaracoes      DeclaracaoEmitida[]
  respostas        RespostaFormulario[]
  documentos       DocumentoAfiliado[]
  dependentes      DependenteAfiliado[]

  @@unique([tenantId, cpf])
  @@unique([tenantId, matricula])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, nome])
  @@map("afiliados")
}

model DocumentoAfiliado {
  id            String                 @id @default(cuid())
  tenantId      String
  afiliadoId    String
  tipo          TipoDocumentoFiliacao
  arquivoChave  String
  nomeOriginal  String
  mimeType      String
  tamanhoBytes  Int
  createdAt     DateTime               @default(now()) @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  afiliado Afiliado @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)

  @@unique([tenantId, afiliadoId, tipo])
  @@index([tenantId, afiliadoId])
  @@map("documentos_afiliado")
}

model DependenteAfiliado {
  id             String   @id @default(cuid())
  tenantId       String
  afiliadoId     String
  nome           String
  parentesco     String
  dataNascimento DateTime @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  afiliado Afiliado @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)

  @@index([tenantId, afiliadoId])
  @@map("dependentes_afiliado")
}

// =====================================================================
// IMPORTAÇÃO D8 (SIAPE — mensalidade sindical)
// =====================================================================

model ImportacaoD8 {
  id               String   @id @default(cuid())
  tenantId         String
  competenciaAno   Int
  competenciaMes   Int
  tipo             TipoD8
  arquivoNome      String
  totalLinhas      Int
  totalValor       Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @db.Timestamptz

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  linhas LinhaD8[]

  @@unique([tenantId, competenciaAno, competenciaMes, tipo])
  @@index([tenantId, competenciaAno, competenciaMes])
  @@map("importacoes_d8")
}

model LinhaD8 {
  id           String   @id @default(cuid())
  tenantId     String
  importacaoId String
  sequencia    Int
  matricula    String
  nome         String
  cpf          String
  descricao    String
  valor        Decimal  @db.Decimal(12, 2)
  afiliadoId   String?

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  importacao ImportacaoD8 @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  afiliado   Afiliado?    @relation(fields: [afiliadoId], references: [id], onDelete: SetNull)

  @@index([importacaoId])
  @@index([tenantId, cpf])
  @@index([tenantId, matricula])
  @@index([afiliadoId])
  @@map("linhas_d8")
}

// =====================================================================
// FASE 2 — NOTÍCIAS (CMS)
// =====================================================================

enum StatusNoticia {
  RASCUNHO
  PUBLICADO
}

model Noticia {
  id          String        @id @default(cuid())
  tenantId    String
  titulo      String
  slug        String
  capaUrl     String?
  anexoUrl    String?
  anexoNome   String?
  conteudo    String        @db.Text
  /// Texto plano curto para listagens (evita carregar o HTML completo).
  resumo      String        @default("")
  status      StatusNoticia @default(RASCUNHO)
  publicadoEm DateTime?     @db.Timestamptz
  autorId     String
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  autor  User   @relation("AutorNoticia", fields: [autorId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId, status, publicadoEm])
  @@map("noticias")
}

// =====================================================================
// FORMULÁRIOS DINÂMICOS
// =====================================================================

/// Quem pode responder. FILIADOS exige afiliado com cadastro aprovado.
enum PublicoFormulario {
  TODOS
  FILIADOS
}

enum StatusFormulario {
  RASCUNHO
  PUBLICADO
  ENCERRADO
}

model Formulario {
  id        String            @id @default(cuid())
  tenantId  String
  titulo    String
  slug      String
  descricao String?           @db.Text
  /// Perguntas do formulário — ver campoFormularioSchema em @sindprf/types.
  /// JSON em vez de tabela: salvar o formulário é um único write e a ordem
  /// das perguntas vem de graça.
  campos    Json              @default("[]")
  publico   PublicoFormulario @default(FILIADOS)
  status    StatusFormulario  @default(RASCUNHO)
  createdAt DateTime          @default(now()) @db.Timestamptz
  updatedAt DateTime          @updatedAt @db.Timestamptz

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  respostas RespostaFormulario[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("formularios")
}

model RespostaFormulario {
  id           String @id @default(cuid())
  tenantId     String
  formularioId String
  /// Nulo quando o formulário é aberto e quem respondeu não estava logado.
  afiliadoId   String?
  /// Respostas com a pergunta congelada no momento do envio — ver
  /// itemRespostaSchema. Editar o formulário depois não reescreve o histórico.
  valores      Json     @default("[]")
  enviadoEm    DateTime @default(now()) @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  formulario Formulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  afiliado   Afiliado?  @relation(fields: [afiliadoId], references: [id], onDelete: SetNull)

  /// Trava "uma resposta por filiado". No Postgres NULLs são distintos entre
  /// si, então respostas anônimas não colidem.
  @@unique([formularioId, afiliadoId])
  @@index([tenantId, formularioId, enviadoEm])
  @@map("respostas_formulario")
}

/// Quem enxerga o alerta. FILIADOS restringe a afiliados com cadastro aprovado.
enum PublicoAlerta {
  TODOS
  FILIADOS
}

/// Aviso em popup exibido no site e na área do filiado durante uma vigência.
model Alerta {
  id        String        @id @default(cuid())
  tenantId  String
  titulo    String
  mensagem  String        @db.Text
  imagemUrl String?
  linkUrl   String?
  linkTexto String?
  publico   PublicoAlerta @default(TODOS)
  /// Permite tirar do ar sem apagar o histórico nem mexer na vigência.
  ativo     Boolean       @default(true)
  inicioEm  DateTime      @db.Timestamptz
  fimEm     DateTime      @db.Timestamptz
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, ativo, inicioEm, fimEm])
  @@map("alertas")
}

// Inscrições Web Push (notificações de notícias)
model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, endpoint])
  @@index([tenantId])
  @@map("push_subscriptions")
}

// Cache do feed do Instagram (Fase 2.4)
model InstagramPost {
  id           String   @id @default(cuid())
  tenantId     String
  externalId   String // id do post na Graph API
  mediaUrl     String
  permalink    String
  caption      String?  @db.Text
  mediaType    String   // IMAGE, VIDEO, CAROUSEL_ALBUM
  publicadoEm  DateTime @db.Timestamptz
  sincronizado DateTime @default(now()) @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([tenantId, publicadoEm])
  @@map("instagram_posts")
}

// =====================================================================
// FASE 3 — CONVÊNIOS
// =====================================================================

enum ModeloDeclaracao {
  FILIADO
  DEPENDENTE
  AUTORIZACAO_HOSPEDAGEM
}

model Convenio {
  id                 String             @id @default(cuid())
  tenantId           String
  nome               String
  categoria          String
  descricao          String             @db.Text
  logoUrl            String?
  link               String?
  contato            String?
  vigenciaInicio     DateTime?          @db.Timestamptz
  vigenciaFim        DateTime?          @db.Timestamptz
  ativo              Boolean            @default(true)
  /// Permite ao afiliado emitir declaração/autorização em PDF.
  emiteDeclaracao    Boolean            @default(false)
  modeloDeclaracao   ModeloDeclaracao?
  /// Ex.: "Unimed Ceará", "Sistema FECOMÉRCIO (SESC/SENAC)".
  destinoDeclaracao  String?
  /// Trecho opcional extra no corpo (ex.: isenção de dependentes no SESC).
  textoComplementar  String?            @db.Text
  createdAt          DateTime           @default(now()) @db.Timestamptz
  updatedAt          DateTime           @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  declaracoes DeclaracaoEmitida[]

  @@index([tenantId, categoria])
  @@map("convenios")
}

/// Aguardando a assinatura física da presidente ou já assinada e devolvida.
enum StatusDeclaracao {
  PENDENTE
  ASSINADA
}

/// Declaração/autorização emitida em PDF — validável via QR Code no site.
model DeclaracaoEmitida {
  id                 String           @id @default(cuid())
  tenantId           String
  /// Código público curto (QR / URL). Único por tenant.
  codigo             String
  convenioId         String
  afiliadoId         String?
  modelo             ModeloDeclaracao
  destino            String
  textoComplementar  String?          @db.Text
  afiliadoNome       String
  afiliadoCpf        String
  dependenteNome     String?
  dependenteCpf      String?
  periodoInicio      DateTime?        @db.Timestamptz
  periodoFim         DateTime?        @db.Timestamptz
  emitidaEm          DateTime         @default(now()) @db.Timestamptz

  status             StatusDeclaracao @default(PENDENTE)
  /// PDF gerado na emissão. Guardado para que o documento assinado depois
  /// seja exatamente o que o filiado baixou, mesmo que a rubrica mude.
  arquivoUrl         String?
  /// PDF devolvido pela presidente, assinado à mão.
  arquivoAssinadoUrl String?
  assinadaEm         DateTime?        @db.Timestamptz
  assinadaPorId      String?

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  convenio    Convenio  @relation(fields: [convenioId], references: [id], onDelete: Restrict)
  afiliado    Afiliado? @relation(fields: [afiliadoId], references: [id], onDelete: Restrict)
  assinadaPor User?     @relation("DeclaracoesAssinadas", fields: [assinadaPorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, codigo])
  @@index([tenantId, emitidaEm])
  @@index([tenantId, status, emitidaEm])
  @@map("declaracoes_emitidas")
}

// =====================================================================
// FASE 4 — ELEIÇÃO / VOTAÇÃO
// -------------------------------------------------------------------
// SIGILO POR DESIGN: Comparecimento e Voto são tabelas SEPARADAS e
// NÃO relacionadas entre si. Não existe FK ligando um Voto a um
// Afiliado. Isso é intencional — não "corrigir" adicionando relação.
// =====================================================================

enum StatusEleicao {
  AGENDADA
  ABERTA
  ENCERRADA
  APURADA
}

enum ChapaStatus {
  INSCRITA
  HOMOLOGADA
  NAO_HOMOLOGADA
}

enum TipoContestacao {
  IMPUGNACAO
  RECURSO
}

enum StatusContestacao {
  ABERTA
  DEFERIDA
  INDEFERIDA
}

model Eleicao {
  id                    String        @id @default(cuid())
  tenantId              String
  titulo                String
  descricao             String?       @db.Text
  inicio                DateTime      @db.Timestamptz
  fim                   DateTime      @db.Timestamptz
  inscricaoInicio       DateTime?     @db.Timestamptz
  inscricaoFim          DateTime?     @db.Timestamptz
  status                StatusEleicao @default(AGENDADA)
  resolvidaPorAclamacao Boolean       @default(false)
  createdAt             DateTime      @default(now()) @db.Timestamptz
  updatedAt             DateTime      @updatedAt @db.Timestamptz

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  chapas          Chapa[]
  elegiveis       Elegivel[]
  comparecimentos Comparecimento[]
  votos           Voto[]
  resultados      ResultadoApuracao[]
  membrosComissao MembroComissaoEleitoral[]

  @@index([tenantId])
  @@map("eleicoes")
}

// Comissão Eleitoral (Art. 38 §4º do Estatuto) — membros ADMIN designados
// para acompanhar/decidir o pleito de uma eleição específica. Registro
// informativo/auditoria: NÃO cria uma permissão própria, os guards
// continuam checando só role === ADMIN.
model MembroComissaoEleitoral {
  id        String   @id @default(cuid())
  tenantId  String
  eleicaoId String
  userId    String
  titular   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eleicao Eleicao @relation(fields: [eleicaoId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eleicaoId, userId])
  @@index([eleicaoId])
  @@index([tenantId])
  @@map("membros_comissao_eleitoral")
}

model Chapa {
  id                        String      @id @default(cuid())
  tenantId                  String
  eleicaoId                 String
  numero                    Int
  nome                      String
  slogan                    String?
  status                    ChapaStatus @default(INSCRITA)
  justificativaHomologacao  String?     @db.Text
  homologadaEm              DateTime?   @db.Timestamptz
  prazoContestacaoFim       DateTime?   @db.Timestamptz
  createdAt                 DateTime    @default(now()) @db.Timestamptz

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eleicao      Eleicao             @relation(fields: [eleicaoId], references: [id], onDelete: Cascade)
  candidatos   Candidato[]
  votos        Voto[]
  resultados   ResultadoApuracao[]
  contestacoes ContestacaoChapa[]

  @@unique([eleicaoId, numero])
  @@index([eleicaoId])
  @@index([tenantId])
  @@map("chapas")
}

// Impugnação (contra chapa HOMOLOGADA) ou recurso (contra NAO_HOMOLOGADA),
// dentro do prazo de Chapa.prazoContestacaoFim (Art. 38 §13º/§18º/§19º).
model ContestacaoChapa {
  id                String            @id @default(cuid())
  tenantId          String
  chapaId           String
  tipo              TipoContestacao
  afiliadoId        String
  motivo            String            @db.Text
  status            StatusContestacao @default(ABERTA)
  decisao           String?           @db.Text
  decididoPorUserId String?
  decididoEm        DateTime?         @db.Timestamptz
  createdAt         DateTime          @default(now()) @db.Timestamptz

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  chapa       Chapa    @relation(fields: [chapaId], references: [id], onDelete: Cascade)
  afiliado    Afiliado @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)
  decididoPor User?    @relation("DecisorContestacao", fields: [decididoPorUserId], references: [id])

  @@index([chapaId])
  @@index([tenantId])
  @@map("contestacoes_chapa")
}

model Candidato {
  id       String  @id @default(cuid())
  tenantId String
  chapaId  String
  nome     String
  cargo    String
  fotoUrl  String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  chapa  Chapa  @relation(fields: [chapaId], references: [id], onDelete: Cascade)

  @@index([chapaId])
  @@index([tenantId])
  @@map("candidatos")
}

// Quem PODE votar em cada eleição
model Elegivel {
  id         String @id @default(cuid())
  tenantId   String
  eleicaoId  String
  afiliadoId String

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eleicao  Eleicao  @relation(fields: [eleicaoId], references: [id], onDelete: Cascade)
  afiliado Afiliado @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)

  @@unique([eleicaoId, afiliadoId]) // não duplica elegibilidade
  @@index([eleicaoId])
  @@index([tenantId])
  @@map("elegiveis")
}

// Registra QUE o afiliado votou (não em quem). Garante voto único.
model Comparecimento {
  id         String   @id @default(cuid())
  tenantId   String
  eleicaoId  String
  afiliadoId String
  votouEm    DateTime @default(now()) @db.Timestamptz
  protocolo  String   @unique // hash entregue ao eleitor, não revela o voto

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eleicao  Eleicao  @relation(fields: [eleicaoId], references: [id], onDelete: Cascade)
  afiliado Afiliado @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)

  @@unique([eleicaoId, afiliadoId]) // CONSTRAINT que garante 1 voto por afiliado
  @@index([eleicaoId])
  @@index([tenantId])
  @@map("comparecimentos")
}

// Registra O voto (em qual chapa), SEM referência ao afiliado. Sigilo.
model Voto {
  id        String   @id @default(cuid())
  tenantId  String
  eleicaoId String
  chapaId   String
  criadoEm  DateTime @default(now()) @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eleicao Eleicao @relation(fields: [eleicaoId], references: [id], onDelete: Cascade)
  chapa   Chapa   @relation(fields: [chapaId], references: [id], onDelete: Cascade)

  // NÃO adicionar afiliadoId aqui. O sigilo depende dessa ausência.
  @@index([eleicaoId])
  @@index([chapaId])
  @@index([tenantId])
  @@map("votos")
}

// Resultado consolidado após apuração (reproduzível)
model ResultadoApuracao {
  id           String   @id @default(cuid())
  tenantId     String
  eleicaoId    String
  chapaId      String
  totalVotos   Int
  percentual   Float
  porAclamacao Boolean  @default(false)
  apuradoEm    DateTime @default(now()) @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eleicao Eleicao @relation(fields: [eleicaoId], references: [id], onDelete: Cascade)
  chapa   Chapa   @relation(fields: [chapaId], references: [id], onDelete: Cascade)

  @@unique([eleicaoId, chapaId])
  @@index([eleicaoId])
  @@index([tenantId])
  @@map("resultados_apuracao")
}

// =====================================================================
// FASE 5 — IMÓVEIS / ALUGUEL
// =====================================================================

enum TipoPeriodo {
  RESERVADO
  BLOQUEADO
}

enum StatusSolicitacao {
  ABERTA
  EM_ANDAMENTO
  FECHADA
}

model Imovel {
  id          String   @id @default(cuid())
  tenantId    String
  titulo      String
  descricao   String   @db.Text
  endereco    String
  valor       Decimal  @db.Decimal(10, 2)
  comodidades String[] // array de texto (Postgres)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fotos        FotoImovel[]
  periodos     Periodo[]
  solicitacoes SolicitacaoAluguel[]

  @@index([tenantId])
  @@map("imoveis")
}

model FotoImovel {
  id       String @id @default(cuid())
  tenantId String
  imovelId String
  url      String
  ordem    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@index([imovelId])
  @@index([tenantId])
  @@map("fotos_imovel")
}

model Periodo {
  id       String      @id @default(cuid())
  tenantId String
  imovelId String
  inicio   DateTime    @db.Timestamptz
  fim      DateTime    @db.Timestamptz
  tipo     TipoPeriodo

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@index([imovelId, inicio, fim])
  @@index([tenantId])
  @@map("periodos")
}

model SolicitacaoAluguel {
  id             String            @id @default(cuid())
  tenantId       String
  imovelId       String
  afiliadoId     String
  inicioDesejado DateTime          @db.Timestamptz
  fimDesejado    DateTime          @db.Timestamptz
  status         StatusSolicitacao @default(ABERTA)
  createdAt      DateTime          @default(now()) @db.Timestamptz
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  imovel    Imovel     @relation(fields: [imovelId], references: [id])
  afiliado  Afiliado   @relation(fields: [afiliadoId], references: [id])
  mensagens Mensagem[]

  @@index([imovelId])
  @@index([afiliadoId])
  @@index([tenantId])
  @@map("solicitacoes_aluguel")
}

model Mensagem {
  id             String   @id @default(cuid())
  tenantId       String
  solicitacaoId  String
  autorId        String
  texto          String   @db.Text
  criadoEm       DateTime @default(now()) @db.Timestamptz

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  solicitacao SolicitacaoAluguel @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  autor       User               @relation("AutorMensagem", fields: [autorId], references: [id])

  @@index([solicitacaoId])
  @@index([tenantId])
  @@map("mensagens")
}

// =====================================================================
// BALANCETE CONTÁBIL (Fortes)
// =====================================================================

enum TipoLinhaBalancete {
  ATIVO
  PASSIVO
  RECEITA
  DESPESA
  OUTRO
}

enum NaturezaConta {
  D
  C
}

model ImportacaoBalancete {
  id             String   @id @default(cuid())
  tenantId       String
  competenciaAno Int
  competenciaMes Int
  arquivoNome    String
  totalLinhas    Int
  totalReceitas  Decimal  @db.Decimal(14, 2)
  totalDespesas  Decimal  @db.Decimal(14, 2)
  resultado      Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  linhas LinhaBalancete[]

  @@unique([tenantId, competenciaAno, competenciaMes])
  @@index([tenantId, competenciaAno, competenciaMes])
  @@map("importacoes_balancete")
}

model LinhaBalancete {
  id            String             @id @default(cuid())
  tenantId      String
  importacaoId  String
  sequencia     Int
  codigoConta   String
  descricao     String
  nivel         Int
  tipo          TipoLinhaBalancete
  natureza      NaturezaConta?
  saldoAnterior Decimal            @db.Decimal(14, 2)
  debitos       Decimal            @db.Decimal(14, 2)
  creditos      Decimal            @db.Decimal(14, 2)
  saldoAtual    Decimal            @db.Decimal(14, 2)
  movimento     Decimal            @db.Decimal(14, 2)
  categoriaSlug String?
  categoriaNome String?
  ehFolha       Boolean            @default(false)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  importacao ImportacaoBalancete @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([importacaoId])
  @@index([importacaoId, tipo])
  @@index([importacaoId, categoriaSlug])
  @@index([tenantId])
  @@map("linhas_balancete")
}
