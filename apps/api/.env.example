# Postgres do docker-compose.yml (raiz do monorepo)
DATABASE_URL="postgresql://sindprf:sindprf@localhost:5432/sindprf?schema=public"

# Porta da API
PORT=3000

# Segredo dos JWTs (gere um valor forte, ex: openssl rand -hex 32)
JWT_SECRET=troque-este-segredo

# Origem liberada no CORS (frontend)
WEB_URL=http://localhost:5173

# Senha do admin criado pelo seed (opcional; padrão Admin@123)
SEED_ADMIN_SENHA=Admin@123
