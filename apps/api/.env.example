# Banco — desenvolvimento local apontando para produção (Supabase).
# Pooler + pgbouncer=true evita erro "prepared statement already exists".
# Cuidado: seed, admin e CRUD locais alteram dados reais.
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?pgbouncer=true"
# Preferir Direct connection. Se db.*.supabase.co não for acessível da sua rede/Docker,
# use o mesmo Session pooler (sem pgbouncer=true) — migrations precisam disso.
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Alternativa: Postgres local
# DATABASE_URL="postgresql://sindprf:sindprf@localhost:5432/sindprf?schema=public"
# DIRECT_URL="postgresql://sindprf:sindprf@localhost:5432/sindprf?schema=public"

# Porta da API
PORT=3000

# Segredo dos JWTs (gere um valor forte, ex: openssl rand -hex 32)
JWT_SECRET=troque-este-segredo

# Origem liberada no CORS (frontend). Em multi-tenant, hosts cadastrados
# em tenant_domains também são aceitos dinamicamente.
WEB_URL=http://localhost:5173

# Hosts extras do tenant seed (vírgula). Útil p/ domínio de staging/produção.
# TENANT_SEED_HOSTS=www.sindprfce.com.br,sindprfce.com.br

# Instagram Graph API (conta Business — ver README, seção "Integração com Instagram")
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# true = serve feed fictício quando não há credenciais (desenvolvimento)
INSTAGRAM_MOCK=true

# Senha do admin criado pelo seed (opcional; padrão Admin@123)
SEED_ADMIN_SENHA=Admin@123

# Senha temporária dos afiliados criados pela importação D8 (padrão Sindprf@D8)
D8_SENHA_TEMP=Sindprf@D8

# --- Contato / Fale conosco (e-mail) ---
# Destino das mensagens do formulário público
CONTATO_DESTINO_EMAIL=seu-email@outlook.com
# Opção A (gratuita): Resend — https://resend.com
RESEND_API_KEY=
RESEND_FROM=SINDPRF-CE <onboarding@resend.dev>
# Opção B: SMTP Outlook/Gmail (veja .env.example da raiz)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Web Push (notificações ao publicar notícia)
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sindprfce@sindprfce.com.br
