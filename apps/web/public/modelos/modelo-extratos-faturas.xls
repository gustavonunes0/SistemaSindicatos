<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
 <Styles>
  <Style ss:ID="Default"><Font ss:FontName="Calibri" ss:Size="11"/></Style>
  <Style ss:ID="Titulo"><Font ss:FontName="Calibri" ss:Size="14" ss:Bold="1"/></Style>
  <Style ss:ID="Cab"><Font ss:Bold="1"/><Interior ss:Color="#D9E2F3" ss:Pattern="Solid"/></Style>
 </Styles>

 <Worksheet ss:Name="Instrucoes">
  <Table>
   <Row><Cell ss:StyleID="Titulo"><Data ss:Type="String">MODELO — Extratos e faturas (SindiGest)</Data></Cell></Row>
   <Row/>
   <Row><Cell><Data ss:Type="String">Como usar</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">1. Preencha a aba Documento com os dados do extrato ou da fatura.</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">2. Preencha a aba Lancamentos com uma linha por movimento.</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">3. A importação automática do sistema lê PDFs de Sicoob e Sicredi.</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">   Este Excel é o padrão de campos exigidos pelo sistema (referência / preenchimento).</Data></Cell></Row>
   <Row/>
   <Row><Cell><Data ss:Type="String">Regras</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">- instituicao: SICOOB ou SICREDI</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">- tipoDocumento: EXTRATO ou FATURA</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">- tipo (lançamento): CREDITO ou DEBITO</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">- Datas no formato AAAA-MM-DD (ex.: 2026-11-01)</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">- Valores com ponto decimal (ex.: 1500.50) — sempre positivos; o tipo define crédito/débito</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">- competenciaMes: 1 a 12</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">- titularDocumento: CPF (11) ou CNPJ (14), só números</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">- Para EXTRATO: informe saldoInicial e saldoFinal (a conciliação deve fechar)</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">- Para FATURA: saldoInicial/saldoFinal podem ficar vazios</Data></Cell></Row>
   <Row/>
   <Row><Cell><Data ss:Type="String">Campos obrigatórios do Documento</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">instituicao, tipoDocumento, competenciaAno, competenciaMes, periodoInicio, periodoFim, agencia, numero, nomeConta</Data></Cell></Row>
   <Row/>
   <Row><Cell><Data ss:Type="String">Campos obrigatórios de cada Lançamento</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">data, descricao, tipo, valor</Data></Cell></Row>
  </Table>
 </Worksheet>

 <Worksheet ss:Name="Documento">
  <Table>
   <Row>
    <Cell ss:StyleID="Cab"><Data ss:Type="String">campo</Data></Cell>
    <Cell ss:StyleID="Cab"><Data ss:Type="String">valor</Data></Cell>
    <Cell ss:StyleID="Cab"><Data ss:Type="String">obrigatorio</Data></Cell>
    <Cell ss:StyleID="Cab"><Data ss:Type="String">exemplo</Data></Cell>
    <Cell ss:StyleID="Cab"><Data ss:Type="String">observacao</Data></Cell>
   </Row>
   <Row><Cell><Data ss:Type="String">instituicao</Data></Cell><Cell><Data ss:Type="String">SICOOB</Data></Cell><Cell><Data ss:Type="String">sim</Data></Cell><Cell><Data ss:Type="String">SICOOB</Data></Cell><Cell><Data ss:Type="String">SICOOB ou SICREDI</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">tipoDocumento</Data></Cell><Cell><Data ss:Type="String">EXTRATO</Data></Cell><Cell><Data ss:Type="String">sim</Data></Cell><Cell><Data ss:Type="String">EXTRATO</Data></Cell><Cell><Data ss:Type="String">EXTRATO ou FATURA</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">competenciaAno</Data></Cell><Cell><Data ss:Type="String">2026</Data></Cell><Cell><Data ss:Type="String">sim</Data></Cell><Cell><Data ss:Type="String">2026</Data></Cell><Cell><Data ss:Type="String">Ano da competência</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">competenciaMes</Data></Cell><Cell><Data ss:Type="String">10</Data></Cell><Cell><Data ss:Type="String">sim</Data></Cell><Cell><Data ss:Type="String">10</Data></Cell><Cell><Data ss:Type="String">Mês 1–12</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">periodoInicio</Data></Cell><Cell><Data ss:Type="String">2026-10-01</Data></Cell><Cell><Data ss:Type="String">sim</Data></Cell><Cell><Data ss:Type="String">2026-10-01</Data></Cell><Cell><Data ss:Type="String">AAAA-MM-DD</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">periodoFim</Data></Cell><Cell><Data ss:Type="String">2026-10-31</Data></Cell><Cell><Data ss:Type="String">sim</Data></Cell><Cell><Data ss:Type="String">2026-10-31</Data></Cell><Cell><Data ss:Type="String">AAAA-MM-DD</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">vencimento</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">não</Data></Cell><Cell><Data ss:Type="String">2026-11-10</Data></Cell><Cell><Data ss:Type="String">Usado em faturas (opcional)</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">totalDocumento</Data></Cell><Cell><Data ss:Type="String"></Data></Cell><Cell><Data ss:Type="String">não</Data></Cell><Cell><Data ss:Type="String">3250.90</Data></Cell><Cell><Data ss:Type="String">Total da fatura/documento (opcional)</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">saldoInicial</Data></Cell><Cell><Data ss:Type="String">10000.00</Data></Cell><Cell><Data ss:Type="String">sim em EXTRATO</Data></Cell><Cell><Data ss:Type="String">10000.00</Data></Cell><Cell><Data ss:Type="String">Saldo no início do período</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">saldoFinal</Data></Cell><Cell><Data ss:Type="String">8540.25</Data></Cell><Cell><Data ss:Type="String">sim em EXTRATO</Data></Cell><Cell><Data ss:Type="String">8540.25</Data></Cell><Cell><Data ss:Type="String">Deve bater com créditos − débitos</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">agencia</Data></Cell><Cell><Data ss:Type="String">1234</Data></Cell><Cell><Data ss:Type="String">sim</Data></Cell><Cell><Data ss:Type="String">1234</Data></Cell><Cell><Data ss:Type="String">Agência da conta</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">numero</Data></Cell><Cell><Data ss:Type="String">56789-0</Data></Cell><Cell><Data ss:Type="String">sim</Data></Cell><Cell><Data ss:Type="String">56789-0</Data></Cell><Cell><Data ss:Type="String">Número da conta</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">nomeConta</Data></Cell><Cell><Data ss:Type="String">Conta corrente SINDPRF-CE</Data></Cell><Cell><Data ss:Type="String">sim</Data></Cell><Cell><Data ss:Type="String">Conta corrente principal</Data></Cell><Cell><Data ss:Type="String">Nome amigável da conta</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">titularNome</Data></Cell><Cell><Data ss:Type="String">Sindicato dos PRFs no CE</Data></Cell><Cell><Data ss:Type="String">não</Data></Cell><Cell><Data ss:Type="String">SINDPRF-CE</Data></Cell><Cell><Data ss:Type="String">Titular da conta</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">titularDocumento</Data></Cell><Cell><Data ss:Type="String">41410325000120</Data></Cell><Cell><Data ss:Type="String">não</Data></Cell><Cell><Data ss:Type="String">41410325000120</Data></Cell><Cell><Data ss:Type="String">CPF 11 ou CNPJ 14 dígitos</Data></Cell></Row>
  </Table>
 </Worksheet>

