# Copie para .env na raiz e preencha antes de `docker compose up --build -d`
# Nunca commite o arquivo .env.

# --- Banco ---
POSTGRES_USER=sindprf
POSTGRES_PASSWORD=troque-por-senha-forte
# Evite @ : / # ? na senha (quebram a DATABASE_URL) ou use URL-encoding.
POSTGRES_DB=sindprf

# --- Portas no host (VPS) ---
WEB_PORT=80
API_PORT=3000

# --- URLs públicas (ajuste para o IP ou domínio da VPS) ---
# Frontend (usado no CORS da API)
WEB_URL=http://SEU_IP_OU_DOMINIO
# API (embutida no build do frontend — precisa ser alcançável pelo navegador)
VITE_API_URL=http://SEU_IP_OU_DOMINIO:3000

# --- Segurança ---
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-este-segredo

# Na primeira subida, use true para criar o admin; depois mude para false
SEED_ON_START=true
SEED_ADMIN_SENHA=TroqueEstaSenha@123

# --- Instagram (opcional) ---
INSTAGRAM_MOCK=false
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
