# Copie para .env na raiz e preencha antes de `docker compose up --build -d`
# Nunca commite o arquivo .env.
# Guia: docs/deploy-vps.md

# --- Banco (Supabase) ---
#
# ATENÇÃO — duas escolhas aqui definem a latência de TODA a API:
#
# 1. REGIÃO: use sa-east-1 (São Paulo). Cada consulta é um round-trip de rede,
#    então um banco em us-west-2 (Oregon) custa ~140ms por consulta contra
#    ~15ms em São Paulo. Medido com: node scripts/medir-latencia-banco.mjs
#
# 2. NÃO use `?pgbouncer=true` na porta 5432. A 5432 é o pooler em modo SESSION,
#    que suporta prepared statements; a flag desliga esse recurso e faz cada
#    consulta custar ~5x mais (medido: 722ms com a flag, 146ms sem).
#    A flag só é necessária na porta 6543 (modo TRANSACTION).
#
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

POSTGRES_USER=sindprf
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=sindprf

# --- Portas livres na VPS Stellar (8080/3000 = Baturité; não usar) ---
WEB_PORT=8081
API_PORT=3002

# --- Hosts Stellar ---
WEB_URL=https://sindprf.stellarsolucoes.com.br
VITE_API_URL=https://apisindigest.stellarsolucoes.com.br
TENANT_SEED_HOSTS=sindprf.stellarsolucoes.com.br
PLATFORM_SEED_HOSTS=sindigest.stellarsolucoes.com.br
CORS_ORIGINS=https://sindigest.stellarsolucoes.com.br,https://sindprf.stellarsolucoes.com.br

# Requisições acima deste tempo (ms) viram log com a divisão entre tempo de
# banco e tempo de aplicação. Baixe o valor para investigar lentidão.
PERF_LOG_MS=700

JWT_SECRET=troque-este-segredo
SEED_ON_START=false
SEED_ADMIN_SENHA=TroqueEstaSenha@123
SEED_SUPERADMIN_EMAIL=superadmin@sindigest.local
D8_SENHA_TEMP=Sindprf@D8

INSTAGRAM_MOCK=false
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sindprfce@sindprfce.com.br

CONTATO_DESTINO_EMAIL=seu-email@outlook.com

# --- E-mail do formulário /contato (escolha UMA opção gratuita) ---
#
# Opção A — Resend (recomendada, 100 e-mails/dia grátis):
# 1. Crie conta em https://resend.com
# 2. API Keys → Create API Key
# 3. CONTATO_DESTINO_EMAIL = o mesmo e-mail da conta Resend
#    (com onboarding@resend.dev só envia para o e-mail da conta)
# 4. Preencha RESEND_API_KEY abaixo
RESEND_API_KEY=
RESEND_FROM=SINDPRF-CE <onboarding@resend.dev>
#
# Opção B — SMTP gratuito (Outlook ou Gmail):
# Outlook:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_USER=seu-email@outlook.com
#   SMTP_PASS=sua-senha-ou-app-password
#   SMTP_FROM=seu-email@outlook.com
# Gmail (precisa senha de app):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=seu-email@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
