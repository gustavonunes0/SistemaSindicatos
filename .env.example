# Copie para .env na raiz e preencha antes de `docker compose up --build -d`
# Nunca commite o arquivo .env.

# --- Banco (Supabase — recomendado na VPS / Vercel) ---
# No Supabase: Connect → Session pooler (ou Transaction :6543 na Vercel) + Direct.
# Pooler precisa de ?pgbouncer=true (Prisma + PgBouncer).
# Se a senha tiver @ : / # ?, use URL-encoding.
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?pgbouncer=true
# Direct (migrations). Se db.*.supabase.co for inacessível, use o Session pooler sem pgbouncer:
DIRECT_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# DIRECT_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@db.SEU_PROJECT_REF.supabase.co:5432/postgres

# --- Alternativa: Postgres local do Compose ---
# 1) DATABASE_URL=postgresql://sindprf:SENHA@postgres:5432/sindprf?schema=public
#    DIRECT_URL=postgresql://sindprf:SENHA@postgres:5432/sindprf?schema=public
# 2) docker compose --profile local-db up --build -d
POSTGRES_USER=sindprf
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=sindprf

# --- Portas no host (VPS) ---
WEB_PORT=80
API_PORT=3000

# --- URLs públicas (IP ou domínio da VPS Hostinger) ---
# Frontend (CORS da API) — SEM barra no final
WEB_URL=http://SEU_IP_OU_DOMINIO
# API usada pelo navegador (embutida no build do front)
VITE_API_URL=http://SEU_IP_OU_DOMINIO:3000

# --- Segurança ---
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-este-segredo

# Admin já existe no Supabase? deixe false.
# Só true na primeira vez se o banco estiver vazio.
SEED_ON_START=false
SEED_ADMIN_SENHA=TroqueEstaSenha@123

# --- Instagram (opcional) ---
INSTAGRAM_MOCK=false
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Web Push (notificações ao publicar notícia) ---
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sindprfce@sindprfce.com.br

# --- Contato / Fale conosco ---
CONTATO_DESTINO_EMAIL=sindprfce@sindprfce.com.br
# Sem SMTP_HOST a API registra a mensagem nos logs (útil em desenvolvimento).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
